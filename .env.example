# Copy to .env for local use only. Never commit a real .env file.
# On Render, set these in the service's Environment tab instead, which keeps
# them private.

# Required. The password for the teacher dashboard. Use at least 8 characters.
TEACHER_PASSWORD=choose-a-long-password

# Alternative to the line above, if you would rather not store the plain
# password with your host. Generate it with: npm run hash-password
# TEACHER_PASSWORD_HASH=scrypt$...$...

# Required in production. The public address of the site, no trailing slash.
# QR codes are built from this, so it must never be localhost.
PUBLIC_BASE_URL=https://your-service-name.onrender.com

# Optional. Render sets PORT for you; 3000 is the local default.
# PORT=3000

# Optional.
# NODE_ENV=production
